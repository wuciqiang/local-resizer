---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSection from '../components/FaqSection.astro';
import FooterLinks from '../components/FooterLinks.astro';
import HowToSection from '../components/HowToSection.astro';
import ImageConverterProcessor from '../components/ImageConverterProcessor.tsx';
import { getRouteBySlug } from '../data/routes';
import { generateBreadcrumbSchema } from '../lib/seo';
import { getRouteBreadcrumbs } from '../lib/site-structure';
import { formatPagePath } from '../lib/urls';

const route = getRouteBySlug('webp-to-jpg');
if (!route) {
  throw new Error('Missing route config for webp-to-jpg.');
}

const breadcrumbItems = getRouteBreadcrumbs(route);
const schemas = [generateBreadcrumbSchema(breadcrumbItems)];
---
<BaseLayout title={route.seo.title} description={route.seo.description} schemas={schemas}>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="max-w-3xl mx-auto px-4 sm:px-5 pt-8 sm:pt-14 pb-5 sm:pb-8 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-stone-200 shadow-soft text-xs font-medium text-stone-500 mb-4 sm:mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
      Static images only - Processed locally
    </div>
    <p class="text-xs font-semibold uppercase text-teal-700 mb-3">Format conversion</p>
    <h1 class="font-[var(--font-heading)] text-3xl md:text-4xl font-bold text-stone-900 mb-4">{route.seo.h1}</h1>
    <p class="text-base sm:text-lg text-stone-500 max-w-2xl mx-auto leading-relaxed">{route.seo.subtitle}</p>
  </section>

  <ImageConverterProcessor
    client:visible
    acceptedTypes={['image/webp']}
    outputType="image/jpeg"
    showQuality={true}
    showBackground={true}
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-5 py-8 sm:py-10">
    <h2 class="font-[var(--font-heading)] text-2xl font-bold text-stone-900 text-center mb-7">What this page is best for</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-xl p-6 border border-stone-100 shadow-soft">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-3">Older upload forms</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Some portals and tools still reject WebP. Converting to JPG gives you a file that legacy systems accept.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-stone-100 shadow-soft">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-3">Controlled transparency loss</h3>
        <p class="text-sm text-stone-500 leading-relaxed">JPG cannot store transparency. You pick the background color that replaces transparent pixels instead of getting an unexpected black fill.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-stone-100 shadow-soft">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-3">Same pixel dimensions, new format</h3>
        <p class="text-sm text-stone-500 leading-relaxed">The output keeps the source width and height. Transparent pixels are flattened to your chosen background, JPEG encoding is lossy, and browser Canvas export typically drops metadata.</p>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-5 pb-6">
    <div class="bg-white rounded-2xl p-7 shadow-soft border border-stone-100 space-y-4">
      <h2 class="font-[var(--font-heading)] text-xl font-semibold text-stone-900">Honest limits of WebP to JPG conversion</h2>
      <p class="text-stone-500 leading-relaxed">
        JPG compression is lossy, so converting can soften fine detail even at high quality. If the source WebP is lossy, detail it already lost cannot be recovered. Canvas export also drops EXIF, GPS, and color-profile metadata in most browsers.
      </p>
      <p class="text-stone-500 leading-relaxed">
        Need a PNG instead? Use the <a href={formatPagePath('photo-to-png')} class="text-teal-700 underline hover:text-teal-900">photo to PNG converter</a>. Need a smaller JPG rather than a format change? Use the <a href={formatPagePath('compress-jpg-file')} class="text-teal-700 underline hover:text-teal-900">compress JPG tool</a>.
      </p>
    </div>
  </section>

  <HowToSection steps={route.howToSteps} />
  <FaqSection items={route.faq} />
  <FooterLinks links={route.relatedLinks} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { phase0Routes } from '../data/routes';
import type { RouteConfig } from '../data/routes';

const title = 'Page Not Found - LocalResizer';
const description = 'The page could not be found. Return to LocalResizer or open one of the popular browser-based image tools.';
const popularSlugs = [
  'resize-image-to-100kb',
  'resize-image-to-200kb',
  'compress-jpeg-to-200kb',
  'resize-youtube-thumbnail',
  'signature-resizer',
  'image-splitter',
];
const popularRoutes = popularSlugs
  .map((slug) => phase0Routes.find((route) => route.slug === slug))
  .filter((route): route is RouteConfig => route !== undefined);
---
<BaseLayout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-5 py-14 sm:py-20">
    <div class="text-center mb-10">
      <span class="inline-block px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold tracking-wide uppercase mb-3">404</span>
      <h1 class="font-[var(--font-heading)] text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-4">Page not found</h1>
      <p class="text-stone-500 max-w-2xl mx-auto leading-relaxed">
        The URL may be outdated or mistyped. Start from the homepage, or open one of the current live tools below.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
      <a href="/" class="inline-flex items-center px-4 py-2.5 bg-teal-600 text-white text-sm font-medium rounded-xl no-underline hover:bg-teal-700 transition-colors">Go to homepage</a>
      <a href="/resize-image" class="inline-flex items-center px-4 py-2.5 bg-white border border-stone-200 text-stone-600 text-sm font-medium rounded-xl no-underline hover:border-teal-300 hover:text-teal-700 hover:bg-teal-50 transition-all">Resize image guide</a>
      <a href="/compress-image" class="inline-flex items-center px-4 py-2.5 bg-white border border-stone-200 text-stone-600 text-sm font-medium rounded-xl no-underline hover:border-teal-300 hover:text-teal-700 hover:bg-teal-50 transition-all">Compress image guide</a>
    </div>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {popularRoutes.map((route) => (
        <a href={`/${route.slug}`} class="no-underline bg-white rounded-2xl p-6 shadow-soft border border-stone-100 hover:border-teal-200 hover:bg-teal-50/40 transition-all">
          <h2 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-2">{route.seo.h1}</h2>
          <p class="text-sm text-stone-500 leading-relaxed">{route.seo.subtitle}</p>
        </a>
      ))}
    </section>
  </article>
</BaseLayout>

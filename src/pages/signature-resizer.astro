---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HowToSection from '../components/HowToSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FooterLinks from '../components/FooterLinks.astro';
import SignatureProcessor from '../components/SignatureProcessor.tsx';
import { STATIC_IMAGE_ACCEPT_FORMATS, getRouteBySlug } from '../data/routes';
import { generateBreadcrumbSchema, generateFAQSchema, generateHowToSchema } from '../lib/seo';
import { getRouteBreadcrumbs } from '../lib/site-structure';

const route = getRouteBySlug('signature-resizer')!;
const breadcrumbItems = getRouteBreadcrumbs(route);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);
const faqSchema = generateFAQSchema(route);
const howToSchema = generateHowToSchema(route);
---
<BaseLayout title={route.seo.title} description={route.seo.description} schemas={[howToSchema, faqSchema, breadcrumbSchema]}>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(13,148,136,0.06),transparent_40%),radial-gradient(circle_at_80%_100%,rgba(245,158,11,0.05),transparent_35%)]" />
    <div class="relative max-w-3xl mx-auto px-4 sm:px-5 pt-10 sm:pt-14 pb-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-stone-200 shadow-soft text-xs font-medium text-stone-500 mb-6 animate-fade-up">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
        Static images only - Processed locally
      </div>
      <h1 class="font-[var(--font-heading)] text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-3 animate-fade-up">{route.seo.h1}</h1>
      <p class="text-lg text-stone-500 max-w-2xl mx-auto animate-fade-up">{route.seo.subtitle}</p>
    </div>
  </section>

  <SignatureProcessor
    client:visible
    acceptFormats={STATIC_IMAGE_ACCEPT_FORMATS}
    defaultDimensions={{ width: 800, height: 300 }}
    defaultTargetSizeBytes={50 * 1024}
    maxFileSize={50 * 1024 * 1024}
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-5 pb-6">
    <div class="text-center mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold tracking-wide uppercase mb-3">Page Fit</span>
      <h2 class="font-[var(--font-heading)] text-2xl font-bold text-stone-900 tracking-tight">What this page is best for</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h2 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Trim extra margins</h2>
        <p class="text-sm text-stone-500 leading-relaxed">Use the automatic trim step to remove empty white or transparent padding before you resize the signature image.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h2 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Choose the output style</h2>
        <p class="text-sm text-stone-500 leading-relaxed">Keep a transparent PNG for signature workflows that need transparency, or export a white-background JPG for older form systems.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h2 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Stay within current limits</h2>
        <p class="text-sm text-stone-500 leading-relaxed">The workflow is still browser-local and best-effort. It does not certify any government, exam, or portal-specific signature rules.</p>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-5 py-8 sm:py-10">
    <div class="text-center mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold tracking-wide uppercase mb-3">Deeper context</span>
      <h2 class="font-[var(--font-heading)] text-2xl font-bold text-stone-900 tracking-tight">How this live page differs from nearby workflows</h2>
      <p class="text-sm text-stone-500 max-w-2xl mx-auto leading-relaxed">
        This page is a real signature workflow, not a generic photo resizer with signature keywords added on top.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Compared with photo pages</h3>
        <p class="text-sm text-stone-500 leading-relaxed">The signature workflow adds automatic whitespace trimming and signature-specific output options instead of only targeting a generic file-size budget.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Compared with exact canvas pages</h3>
        <p class="text-sm text-stone-500 leading-relaxed">This page optimizes a signature asset for upload rules. It does not target a fixed social-media canvas like the YouTube routes.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Current limits</h3>
        <p class="text-sm text-stone-500 leading-relaxed">The page does not certify government or exam rules and does not generate signatures. It only resizes and cleans an uploaded static image locally.</p>
      </div>
    </div>
  </section>

  <HowToSection steps={route.howToSteps} />
  <FaqSection items={route.faq} />
  <FooterLinks links={['photo-resizer-20kb', 'compress-jpg-file', 'resize-png']} />
</BaseLayout>

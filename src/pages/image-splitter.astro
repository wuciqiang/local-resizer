---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HowToSection from '../components/HowToSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FooterLinks from '../components/FooterLinks.astro';
import ImageSplitterProcessor from '../components/ImageSplitterProcessor.tsx';
import { STATIC_IMAGE_ACCEPT_FORMATS, getRouteBySlug } from '../data/routes';
import { generateBreadcrumbSchema, generateFAQSchema, generateHowToSchema } from '../lib/seo';
import { getRouteBreadcrumbs } from '../lib/site-structure';

const route = getRouteBySlug('image-splitter')!;
const breadcrumbItems = getRouteBreadcrumbs(route);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);
const faqSchema = generateFAQSchema(route);
const howToSchema = generateHowToSchema(route);
---
<BaseLayout title={route.seo.title} description={route.seo.description} schemas={[howToSchema, faqSchema, breadcrumbSchema]}>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_-5%,rgba(14,165,233,0.08),transparent_35%),radial-gradient(circle_at_75%_100%,rgba(13,148,136,0.07),transparent_35%)]" />
    <div class="relative max-w-3xl mx-auto px-4 sm:px-5 pt-10 sm:pt-14 pb-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-stone-200 shadow-soft text-xs font-medium text-stone-500 mb-6 animate-fade-up">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
        Static images only - Processed locally
      </div>
      <h1 class="font-[var(--font-heading)] text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-3 animate-fade-up">{route.seo.h1}</h1>
      <p class="text-lg text-stone-500 max-w-2xl mx-auto animate-fade-up">{route.seo.subtitle}</p>
    </div>
  </section>

  <ImageSplitterProcessor
    client:visible
    acceptFormats={STATIC_IMAGE_ACCEPT_FORMATS}
    maxFileSize={50 * 1024 * 1024}
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-5 pb-6">
    <div class="text-center mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold tracking-wide uppercase mb-3">Page Fit</span>
      <h2 class="font-[var(--font-heading)] text-2xl font-bold text-stone-900 tracking-tight">How to split an image into pieces</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Simple grid split</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Start with rows and columns. The tool cuts the image into evenly sized tiles without requiring a manual crop editor.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Local downloads</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Each tile is generated in the browser and downloaded separately, which keeps the first version lightweight and predictable.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Static images only</h3>
        <p class="text-sm text-stone-500 leading-relaxed">The current splitter is limited to static JPEG, PNG, and WebP files. It does not split PDFs, videos, or GIF frames.</p>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-5 py-8 sm:py-10">
    <div class="text-center mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold tracking-wide uppercase mb-3">Deeper context</span>
      <h2 class="font-[var(--font-heading)] text-2xl font-bold text-stone-900 tracking-tight">When to use an image splitter instead of a crop tool</h2>
      <p class="text-sm text-stone-500 max-w-2xl mx-auto leading-relaxed">
        This page adds a new image utility workflow instead of pretending a resize or compress page can also behave like a splitter.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Compared with resize pages</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Resize pages return one processed image. The splitter turns one uploaded image into multiple tiles that can be downloaded separately.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Compared with crop tools</h3>
        <p class="text-sm text-stone-500 leading-relaxed">This is a predictable grid split, not a freeform crop editor. The first version focuses on rows and columns only.</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] font-semibold text-stone-900 mb-3">Current limits</h3>
        <p class="text-sm text-stone-500 leading-relaxed">The splitter does not handle PDF pages, videos, or GIF frames. It only works on static JPEG, PNG, and WebP files.</p>
      </div>
    </div>
  </section>

  <HowToSection steps={route.howToSteps} />
  <FaqSection items={route.faq} />
  <FooterLinks links={['resize-png', 'photo-resizer-20kb', 'compress-jpg-file']} />
</BaseLayout>

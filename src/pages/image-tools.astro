---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { phase0Routes } from '../data/routes';
import { generateBreadcrumbSchema } from '../lib/seo';
import { getHubBreadcrumbs } from '../lib/site-structure';

const title = 'Image Tools Guide - Splitter and Utility Workflows | LocalResizer';
const description = 'Explore the current utility image workflows on LocalResizer, including grid-based image splitting and related tools for static images.';
const breadcrumbItems = getHubBreadcrumbs('image-tools');
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);
const utilityRoutes = phase0Routes.filter((route) => route.intent === 'image-splitter' || route.intent === 'signature');
---
<BaseLayout title={title} description={description} schemas={[breadcrumbSchema]}>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="max-w-4xl mx-auto px-4 sm:px-5 py-10 sm:py-14">
    <div class="text-center mb-10">
      <span class="inline-block px-3 py-1 rounded-full bg-sky-50 text-sky-700 text-xs font-semibold tracking-wide uppercase mb-3">Guide</span>
      <h1 class="font-[var(--font-heading)] text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-4">Utility image tools for the current live workflows</h1>
      <p class="text-stone-500 max-w-2xl mx-auto leading-relaxed">
        Not every image task fits into a standard resize or compress page. This guide groups the current utility workflows so users and search engines can understand how these specialized tools relate to the rest of the site.
      </p>
    </div>

    <section class="bg-white rounded-2xl p-7 shadow-soft border border-stone-100 mb-8 space-y-4">
      <h2 class="font-[var(--font-heading)] text-xl font-semibold text-stone-900">What counts as a utility workflow here</h2>
      <p class="text-stone-500 leading-relaxed">
        Utility workflows solve a narrower problem than a general image resizer. The current live examples are signature cleanup and grid-based image splitting. They still run locally in the browser, but the interaction and expected output are different from target-size pages.
      </p>
      <p class="text-stone-500 leading-relaxed">
        This matters for SEO because these pages deserve their own context instead of being buried under generic image-resizer language. The guide helps route users to the correct specialized page and sets clearer expectations about what each page can and cannot do.
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
      {utilityRoutes.map((route) => (
        <a href={`/${route.slug}`} class="no-underline bg-white rounded-2xl p-6 shadow-soft border border-stone-100 hover:border-teal-200 hover:bg-teal-50/40 transition-all">
          <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-2">{route.seo.h1}</h3>
          <p class="text-sm text-stone-500 leading-relaxed">{route.seo.subtitle}</p>
        </a>
      ))}
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-3">Use image splitter when</h3>
        <ul class="space-y-3 text-sm text-stone-500 leading-relaxed list-disc pl-5">
          <li>You need evenly divided tiles from one static image.</li>
          <li>You want a preview of the grid before export.</li>
          <li>You do not need freeform cropping, PDF slicing, or GIF frame extraction.</li>
        </ul>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-soft border border-stone-100">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-3">Use another page instead when</h3>
        <ul class="space-y-3 text-sm text-stone-500 leading-relaxed list-disc pl-5">
          <li>The real goal is just to reduce file size.</li>
          <li>You need one resized output instead of multiple pieces.</li>
          <li>You are working with formats outside the current static-image scope.</li>
        </ul>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a href="/image-splitter" class="no-underline bg-white rounded-2xl p-6 shadow-soft border border-stone-100 hover:border-teal-200 hover:bg-teal-50/40 transition-all">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-2">Image Splitter Online</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Open the live splitter page when you need a rows-by-columns grid with visual split lines before processing.</p>
      </a>
      <a href="/resize-png" class="no-underline bg-white rounded-2xl p-6 shadow-soft border border-stone-100 hover:border-teal-200 hover:bg-teal-50/40 transition-all">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-2">Resize PNG</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Use the PNG resize page when you need one adjusted image instead of multiple split pieces.</p>
      </a>
      <a href="/supported-formats" class="no-underline bg-white rounded-2xl p-6 shadow-soft border border-stone-100 hover:border-teal-200 hover:bg-teal-50/40 transition-all">
        <h3 class="font-[var(--font-heading)] text-lg font-semibold text-stone-900 mb-2">Supported Formats</h3>
        <p class="text-sm text-stone-500 leading-relaxed">Review the live scope before you expect PDF, video, or animated GIF workflows from these utility pages.</p>
      </a>
    </section>
  </article>
</BaseLayout>

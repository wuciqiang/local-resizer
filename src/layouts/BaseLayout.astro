---
import '../styles/global.css';
import { formatPagePath, formatPageUrl } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemas?: object[];
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  schemas = [],
  socialImage = '/og-default.png',
  socialImageAlt = 'LocalResizer browser-based image resizing and compression tool',
} = Astro.props;
const canonicalUrl = canonical || formatPageUrl(Astro.url.pathname);

const badgeMarquee = [
  { label: 'Product Hunt', href: 'https://www.producthunt.com' },
  { label: 'StartupBase', href: 'https://startupbase.io' },
  { label: 'webgora', href: 'https://webgora.com' },
  { label: 'FutureTools', href: 'https://futuretools.io' },
  { label: 'AI Agents Live', href: 'https://aiagentslive.com' },
  { label: 'ListedAI', href: 'https://www.listedai.co' },
  { label: 'ScriptByAI', href: 'https://www.scriptbyai.com' },
  { label: 'Insidr.ai', href: 'https://www.insidr.ai' },
  { label: 'EverList', href: 'https://everlist.dev' },
  { label: 's5-style', href: 'https://www.s5-style.com' },
  { label: 'AI Boom', href: 'https://aiboom.tools' },
  { label: 'AI Findr', href: 'https://ai-findr.com' },
  { label: 'AI138', href: 'https://ai138.com' },
  { label: 'AI Index', href: 'https://aiindex.tools' },
  { label: 'AI Tooli', href: 'https://aitooli.com' },
  { label: 'AI Toolz Dir', href: 'https://www.aitoolzdir.com' },
  { label: 'DeepLaunch', href: 'https://deeplaunch.io' },
  { label: 'Fazier', href: 'https://fazier.com' },
  { label: 'Free Web Submission', href: 'https://freewebsubmission.com' },
  { label: 'Gets.tools', href: 'https://gets.tools' },
  { label: 'Indie.deals', href: 'https://indie.deals' },
  { label: 'Next Launch', href: 'https://nextlaunch.io' },
  { label: 'Right AI', href: 'https://right-ai.com' },
  { label: 'SeeWhatNewAI', href: 'https://seewhatnewai.com' },
  { label: 'TinyLaunch', href: 'https://tinylaunch.com' },
  { label: 'ToolDirs', href: 'https://tooldirs.com' },
  { label: 'ToolPilot', href: 'https://toolpilot.ai' },
  { label: 'ToolsApp', href: 'https://toolsapp.cc' },
  { label: 'Turbo0', href: 'https://turbo0.com' },
  { label: 'Twelve Tools', href: 'https://twelve.tools' },
  { label: 'What Is AI Tools', href: 'https://whatisaitools.com' },
];
const currentPath = formatPagePath(Astro.url.pathname);
const ogImageUrl = new URL(socialImage, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <meta name="theme-color" content="#0f766e" />
  <link rel="alternate" type="application/rss+xml" title="LocalResizer RSS Feed" href="https://localresizer.com/feed.xml" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.google-analytics.com" />
  <link rel="preconnect" href="https://umami-blue-zeta.vercel.app" />
  <link rel="preconnect" href="https://www.clarity.ms" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LocalResizer" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {schemas.map(schema => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class="min-h-screen flex flex-col bg-[var(--color-surface)] text-[var(--color-text-primary)]">
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-[var(--color-border-light)]">
    <nav class="max-w-5xl mx-auto px-4 sm:px-5 h-14 sm:h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 no-underline group shrink-0">
        <img src="/logo-header.webp" alt="LocalResizer" width="380" height="101" decoding="async" class="block w-[128px] sm:w-[190px] h-auto transition-transform group-hover:scale-[1.02]" />
      </a>
      <div class="flex items-center gap-0.5 sm:gap-1 overflow-x-auto">
        {[
          { href: '/', label: 'Home', mobileHidden: true },
          { href: formatPagePath('resize-image'), label: 'Resize' },
          { href: formatPagePath('compress-image'), label: 'Compress' },
          { href: formatPagePath('supported-formats'), label: 'Supported' },
        ].map(link => (
          <a
            href={link.href}
            class:list={[
              'px-2 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all no-underline whitespace-nowrap shrink-0',
              link.mobileHidden ? 'hidden sm:inline-flex' : '',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-teal-700 bg-teal-50'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-stone-100',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  </header>

  <!-- Main -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-[var(--color-border)] bg-white">
    <div class="badge-marquee" aria-label="Listed on these directories">
      <div class="badge-marquee__track">
        {[...badgeMarquee, ...badgeMarquee].map((badge) => (
          <a class="badge-marquee__item" href={badge.href} target="_blank" rel="noopener noreferrer">
            <span class="badge-marquee__dot" aria-hidden="true"></span>
            <span>{badge.label}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-5 py-8 sm:py-10">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <img src="/logo-header.webp" alt="LocalResizer" width="380" height="101" loading="lazy" decoding="async" class="block w-[150px] sm:w-[170px] h-auto" />
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-sm">
          <a href={formatPagePath('supported-formats')} class="text-[var(--color-text-tertiary)] hover:text-teal-700 transition-colors no-underline">Supported</a>
          <a href={formatPagePath('about')} class="text-[var(--color-text-tertiary)] hover:text-teal-700 transition-colors no-underline">About</a>
          <a href={formatPagePath('privacy')} class="text-[var(--color-text-tertiary)] hover:text-teal-700 transition-colors no-underline">Privacy</a>
          <a href={formatPagePath('terms')} class="text-[var(--color-text-tertiary)] hover:text-teal-700 transition-colors no-underline">Terms</a>
          <a href={formatPagePath('contact')} class="text-[var(--color-text-tertiary)] hover:text-teal-700 transition-colors no-underline">Contact</a>
          <a href="/feed.xml" class="text-[var(--color-text-tertiary)] hover:text-teal-700 transition-colors no-underline">RSS Feed</a>
        </div>
      </div>
      <div class="mt-6 flex justify-center">
        <a
          href="https://awesomeindie.com/product/localresizer?ref=badge"
          target="_blank"
          rel="nofollow noopener"
          class="no-underline inline-flex"
        >
          <img
            src="https://awesomeindie.com/images/badges/awesome-indie-featured-light.svg"
            alt="localresizer — Featured on Awesome Indie"
            width="184"
            height="54"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
      <div class="mt-6 pt-6 border-t border-[var(--color-border-light)] flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-[var(--color-text-tertiary)]">
        <p>&copy; {new Date().getFullYear()} LocalResizer. All rights reserved.</p>
        <p class="flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          All processing happens in your browser
        </p>
      </div>
    </div>
  </footer>
  <script is:inline>
    const analyticsHostnames = new Set(['localresizer.com', 'www.localresizer.com']);
    const analyticsEnabled = analyticsHostnames.has(window.location.hostname);
    const blockedAnalyticsParams = new Set(['email', 'name', 'file_name', 'fileName', 'url', 'image_url', 'result_url', 'user_agent']);
    const normalizeAnalyticsParam = (value) => value.trim().toLowerCase().replace(/\s+/g, '_').slice(0, 80);
    const analyticsPageId = (pathname = window.location.pathname) => pathname.split('/').filter(Boolean).join('_') || 'home';
    const cleanAnalyticsParams = (params) => Object.fromEntries(
      Object.entries(params)
        .filter(([key, value]) => !blockedAnalyticsParams.has(key) && value !== undefined && value !== null)
        .map(([key, value]) => [key, typeof value === 'string' ? normalizeAnalyticsParam(value) : value])
    );

    if (analyticsEnabled) {
      const gaScript = document.createElement('script');
      gaScript.async = true;
      gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-4FZK267R1E';
      document.head.appendChild(gaScript);

      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){dataLayer.push(arguments);}
      window.gtag('js', new Date());
      window.gtag('config', 'G-4FZK267R1E', {
        page_path: window.location.pathname,
        page_title: document.title
      });

      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, 'clarity', 'script', 'xjswanreey');
    }

    window.lrTrackEvent = function lrTrackEvent(eventName, params = {}) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', eventName, cleanAnalyticsParams({
        page_id: analyticsPageId(),
        ...params
      }));
    };

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
      if (!link) return;
      const href = link.getAttribute('href') || '';
      if (href.startsWith('mailto:')) {
        window.lrTrackEvent('contact_click', {
          category: 'engagement',
          tool_action: 'email',
          from_page: analyticsPageId()
        });
        return;
      }
      const targetUrl = new URL(href, window.location.origin);
      if (targetUrl.origin !== window.location.origin) {
        window.lrTrackEvent('outbound_link_click', {
          category: 'navigation',
          tool_action: 'outbound',
          from_page: analyticsPageId()
        });
        return;
      }
      window.lrTrackEvent('related_page_click', {
        category: 'navigation',
        tool_action: 'internal_link',
        from_page: analyticsPageId(),
        result_type: analyticsPageId(targetUrl.pathname)
      });
    });

    if (analyticsEnabled) {
      const umamiScript = document.createElement('script');
      umamiScript.async = true;
      umamiScript.defer = true;
      umamiScript.src = 'https://umami-blue-zeta.vercel.app/script.js';
      umamiScript.dataset.websiteId = 'a4db5007-1ce3-438f-b139-1e0e873b46c6';
      document.body.appendChild(umamiScript);
    }
  </script>
</body>
</html>
